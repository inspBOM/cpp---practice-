#include<iostream>
using namespace std;

int main()
{
    double num, sum = 0, average = 0;

    for ( int i = 0; i < 10; i++ ) {
        cout << "Enter ten numbers. " << endl;
        cin >> num;
        sum = sum + num ;
    }
    average = sum / 10;

    cout << "The sum for these numbers is: " << sum << endl;
    cout << "The average number for these numbers is: " << average << endl;
    return 0;
}